DATABASE_URL=postgresql+asyncpg://jobfetch:jobfetch@localhost:5432/jobfetch
API_KEY=dev-local-key
LOG_LEVEL=INFO

# Optional: enables the Adzuna/Jooble connectors (disabled in the sources
# table until these are set). Adzuna signup is free/instant at
# https://developer.adzuna.com/signup. Jooble requires requesting a key
# at https://jooble.org/api/about.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional: publishes verified jobs into BidFlow's job_feed.jobs
# (docs/bidflow/JOB_FEED_CONTRACT.md). Leave empty to disable. BidFlow's admin
# supplies host/db/password; TLS is required in production.
# Local replica: postgresql+asyncpg://jobfeed_writer:local-only-change-me@localhost:5432/bidflow_replica
# with BIDFLOW_SSL=disable.
BIDFLOW_DATABASE_URL=
BIDFLOW_SSL=require
PUBLISH_INTERVAL_SECONDS=600
